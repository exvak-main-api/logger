--[[
  aspect_bridge.luau
  Thin adapter so the rest of logger/spy can call Aspect with a stable API.
  Strips Aspect banners and wraps output in the OSE header only.
]]

local fs = require("@lune/fs")

local Bridge = {}

local OSE_HEADER = table.concat({
	"-- [[",
	"this file was constructed by OSE env logger",
	"@ discord.gg/uEWVqpnyf2",
	"]] --",
	"",
}, "\n")

local function stripNoise(body: string): string
	if type(body) ~= "string" then
		return ""
	end
	-- drop leading Aspect / generic multi-line banners
	body = body:gsub("^%s*%-%-%[%[.-%]%]%s*", "")
	body = body:gsub("^%s*%-%-%[%[.-%]%s*%]%s*%-%-?%s*", "")
	-- drop common noise comment lines at the top
	local cleaned = {}
	local started = false
	for line in (body .. "\n"):gmatch("(.-)\n") do
		local trimmed = line:match("^%s*(.-)%s*$") or ""
		if not started then
			if trimmed == "" then
				-- skip leading blanks
			elseif trimmed:match("^%-%-.*generated by Aspect") then
				-- skip
			elseif trimmed:match("^%-%-.*reconstructed by") then
				-- skip
			elseif trimmed:match("^%-%-.*original size") then
				-- skip
			elseif trimmed:match("^%-%-.*source:") then
				-- skip
			elseif trimmed:match("^%-%- === ") then
				-- skip section markers until real code
			else
				started = true
				table.insert(cleaned, line)
			end
		else
			table.insert(cleaned, line)
		end
	end
	local out = table.concat(cleaned, "\n")
	out = out:gsub("%s+$", "")
	return out
end

function Bridge.wrap(body: string): string
	local core = stripNoise(body)
	if core == "" then
		core = "-- (empty dump)"
	end
	return OSE_HEADER .. core .. "\n"
end

local function writeClean(path: string, body: string)
	fs.writeFile(path, Bridge.wrap(body))
end

local function safeRequireAspect()
	local ok, mod = pcall(require, "./aspect")
	if not ok then
		return nil, tostring(mod)
	end
	return mod, nil
end

function Bridge.available(): (boolean, string?)
	local mod, err = safeRequireAspect()
	if not mod then
		return false, err
	end
	if type(mod.dumpfile) ~= "function" and type(mod.dumpstring) ~= "function" then
		return false, "aspect module loaded but missing dumpfile/dumpstring"
	end
	return true, nil
end

function Bridge.dumpFile(inputPath: string, outputPath: string?): (boolean, string, any?)
	local aspect, err = safeRequireAspect()
	if not aspect then
		return false, err or "aspect require failed", nil
	end

	if not fs.isFile(inputPath) then
		return false, "input file not found: " .. inputPath, nil
	end

	local out = outputPath or (inputPath:gsub("%.lua[u]?$", "") .. "_aspect.lua")

	if type(aspect.reset) == "function" then
		pcall(aspect.reset)
	end

	local ok, result = pcall(function()
		if type(aspect.dumpfile) == "function" then
			return aspect.dumpfile(inputPath, out)
		end
		local src = fs.readFile(inputPath)
		return aspect.dumpstring(src, out)
	end)

	if not ok then
		return false, "aspect runtime error: " .. tostring(result), nil
	end

	local body = nil
	if fs.isFile(out) then
		body = fs.readFile(out)
	end
	if (not body or body == "") and type(aspect.getout) == "function" then
		local gOk, g = pcall(aspect.getout)
		if gOk and type(g) == "string" and #g > 0 then
			body = g
		end
	end
	if not body or body == "" then
		return false, "aspect finished but produced no output at " .. out, nil
	end

	writeClean(out, body)

	local stats = nil
	if type(aspect.stats) == "function" then
		local sOk, s = pcall(aspect.stats)
		if sOk then
			stats = s
		end
	end
	return true, out, stats
end

function Bridge.dumpString(source: string, outputPath: string): (boolean, string, any?)
	local aspect, err = safeRequireAspect()
	if not aspect then
		return false, err or "aspect require failed", nil
	end

	if type(aspect.reset) == "function" then
		pcall(aspect.reset)
	end

	local ok, result = pcall(function()
		if type(aspect.dumpstring) == "function" then
			return aspect.dumpstring(source, outputPath)
		end
		local tmp = outputPath:gsub("%.lua[u]?$", "") .. "_tmp_in.lua"
		fs.writeFile(tmp, source)
		local r = aspect.dumpfile(tmp, outputPath)
		pcall(function()
			fs.removeFile(tmp)
		end)
		return r
	end)

	if not ok then
		return false, "aspect runtime error: " .. tostring(result), nil
	end

	local body = nil
	if fs.isFile(outputPath) then
		body = fs.readFile(outputPath)
	end
	if (not body or body == "") and type(aspect.getout) == "function" then
		local gOk, g = pcall(aspect.getout)
		if gOk and type(g) == "string" and #g > 0 then
			body = g
		end
	end
	if not body or body == "" then
		return false, "aspect finished but produced no output", nil
	end

	writeClean(outputPath, body)
	return true, outputPath, nil
end

return Bridge
